# --- Generated artefacts (regenerate by running the pipeline in numeric order) ---
# The source .xlsx files in e_coli/data/ and mammalian/ ARE tracked, so a fresh
# clone can run the pipeline as-is. Everything the pipeline writes is not.
e_coli/output/*
!e_coli/output/.gitkeep

# Excel lock files, in case the source workbooks get opened
~$*.xlsx

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Node (31_make_slides.js) ---
node_modules/
package-lock.json

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

